# ==============================================================================
# FITLIFE - ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (.env.example)
# Copia este archivo a ".env" y reemplaza los valores con tu configuración real.
# ==============================================================================

# Clave secreta de Django (Generar una aleatoria en producción)
SECRET_KEY=django-insecure-fitlife-local-secret-key-change-in-production

# Modo depuración (True en desarrollo, False en producción en AWS)
DEBUG=True

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Configuración de Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
DB_NAME=fitlife_db
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# Parámetros del gimnasio FitLife
# ------------------------------------------------------------------------------
AFORO_MAXIMO=200
POLLING_INTERVAL_SECONDS=5
